{
  "rules": {
    "roles": {
      ".read": "auth !== null",
      ".write": "auth !== null && root.child('roles/' + auth.uid + '/role').val() === 'admin'"
    },
    "assignments": {
      "$uid": {
        ".read": "auth !== null && (root.child('roles/' + auth.uid + '/role').val() === 'admin' || auth.uid === $uid)",
        ".write": "auth !== null && root.child('roles/' + auth.uid + '/role').val() === 'admin'"
      }
    },
    "users": {
      ".read": true,
      ".write": "auth !== null && root.child('roles/' + auth.uid + '/role').val() === 'admin'",
      "$patientId": {
        ".read": true,
        ".write": "(auth !== null && (auth.uid === $patientId || root.child('roles/' + auth.uid + '/role').val() === 'admin' || root.child('assignments/' + auth.uid + '/' + $patientId).val() === true)) || $patientId.beginsWith('ECHO-')",
        "commands": {
          ".indexOn": ["timestamp"]
        }
      }
    },
    ".read": "auth !== null && root.child('roles/' + auth.uid + '/role').val() === 'admin'",
    ".write": "auth !== null && root.child('roles/' + auth.uid + '/role').val() === 'admin'"
  }
}
